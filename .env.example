# Gmail Configuration for Email Verification & Password Reset
# ===================================

# Gmail SMTP Configuration
# You need to:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an App-Specific Password at https://myaccount.google.com/apppasswords
# 3. Copy the 16-character password below

GMAIL_USER=your-email@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx

# Alternative Email Service (Optional)
# If not using Gmail, you can configure other services
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your-api-key

# Application Settings
PORT=3000
NODE_ENV=development

# Email Settings
EMAIL_FROM_NAME=PingNow Chat
EMAIL_FROM_ADDRESS=noreply@pingnow.com

# Verification & Reset Timeouts (in minutes)
VERIFICATION_CODE_EXPIRY=10
RESET_CODE_EXPIRY=15

# Security Settings
MAX_VERIFICATION_ATTEMPTS=5
MAX_RESET_ATTEMPTS=5
